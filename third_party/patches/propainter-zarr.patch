+def write_mp4_rgb(path, frames, fps):
+    """
+    保存 RGB uint8 帧为 mp4（稳定版）：
+    - 只用 OpenCV VideoWriter，避免 imageio 插件误判导致损坏
+    - 自动保证输出尺寸为偶数（很多 mp4 编码器对奇数尺寸兼容差）
+    """
+    frames = [np.asarray(f).astype(np.uint8) for f in frames]
+    if not frames:
+        return
+
+    h, w = frames[0].shape[:2]
+    out_w = w - (w % 2)
+    out_h = h - (h % 2)
+    if out_w <= 0 or out_h <= 0:
+        raise ValueError(f"Invalid frame size: {(w, h)}")
+
+    proc = []
+    for fr in frames:
+        if fr.shape[:2] != (h, w):
+            fr = cv2.resize(fr, (w, h), interpolation=cv2.INTER_LINEAR)
+        if (out_w, out_h) != (w, h):
+            fr = cv2.resize(fr, (out_w, out_h), interpolation=cv2.INTER_LINEAR)
+        proc.append(fr)
+
+    fps = max(1.0, float(fps))
+    candidates = ["mp4v", "avc1", "H264", "XVID"]
+    vw = None
+    for cc in candidates:
+        writer = cv2.VideoWriter(path, cv2.VideoWriter_fourcc(*cc), fps, (out_w, out_h))
+        if writer.isOpened():
+            vw = writer
+            break
+        writer.release()
+    if vw is None:
+        raise RuntimeError(f"Failed to open VideoWriter for {path}")
+
+    for fr in proc:
+        vw.write(cv2.cvtColor(fr, cv2.COLOR_RGB2BGR))
+    vw.release()
+
+
+def save_png_sequence_rgb(frames, output_dir):
