+def read_mask_from_npz(npz_path, length, size, flow_mask_dilates=8, mask_dilates=5, key='masks'):
+    """
+    Read frame-wise masks from npz, expects bool/0-1 array:
+      - (T, H, W) or
+      - (H, W) (will be repeated to match `length`)
+    """
+    obj = np.load(npz_path)
+    if key not in obj:
+        raise KeyError(f"Key '{key}' not found in npz: {npz_path}, available={obj.files}")
+
+    arr = obj[key]
+    if arr.ndim == 2:
+        arr = np.repeat(arr[None, ...], length, axis=0)
+    elif arr.ndim != 3:
+        raise ValueError(f"Unsupported mask shape {arr.shape} in {npz_path}")
+
+    if arr.shape[0] != length:
+        raise ValueError(
+            f"Mask length mismatch: npz has {arr.shape[0]} frames but video has {length} frames"
+        )
+
+    flow_masks = []
+    masks_dilated = []
+    for i in range(length):
+        mask_np = arr[i]
+        if size is not None:
+            mask_np = cv2.resize(mask_np.astype(np.uint8), size, interpolation=cv2.INTER_NEAREST)
+        mask_np = (mask_np > 0).astype(np.uint8)
+
+        if flow_mask_dilates > 0:
+            flow_mask_img = scipy.ndimage.binary_dilation(mask_np, iterations=flow_mask_dilates).astype(np.uint8)
+        else:
+            flow_mask_img = mask_np
+        flow_masks.append(Image.fromarray(flow_mask_img * 255))
+
+        if mask_dilates > 0:
+            mask_d = scipy.ndimage.binary_dilation(mask_np, iterations=mask_dilates).astype(np.uint8)
+        else:
+            mask_d = mask_np
+        masks_dilated.append(Image.fromarray(mask_d * 255))
+
+    return flow_masks, masks_dilated
+
