+def read_frame_from_zarr(zarr_path):
+    """Read RGB frames from aligned zarr: data/frame_xxxxx/rgb."""
+    import zarr
+
+    root = zarr.open(zarr_path, mode='r')
+    if 'data' not in root:
+        raise KeyError(f"'data' group not found in zarr: {zarr_path}")
+    data = root['data']
+    frame_keys = sorted(list(data.keys()))
+    if len(frame_keys) == 0:
+        raise ValueError(f"No frames found under zarr/data: {zarr_path}")
+
+    frames = []
+    for fk in frame_keys:
+        if 'rgb' not in data[fk]:
+            raise KeyError(f"'rgb' not found in {fk} of zarr: {zarr_path}")
+        rgb = data[fk]['rgb'][:].astype(np.uint8)
+        frames.append(Image.fromarray(rgb))
+
+    fps = None
+    size = frames[0].size
+    video_name = os.path.splitext(os.path.basename(zarr_path.rstrip('/')))[0]
+    return frames, fps, size, video_name
