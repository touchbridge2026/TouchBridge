+def open_temporal_memmap(cache_dir, name, shape, dtype):
+    """Create a disk-backed array for a full video timeline."""
+    return np.lib.format.open_memmap(
+        os.path.join(cache_dir, f"{name}.npy"),
+        mode="w+",
+        dtype=dtype,
+        shape=shape,
+    )
+
+
+def cache_to_device(cache, indices, device, dtype):
+    """Copy only the requested timeline entries from disk to the inference device."""
+    array = np.array(cache[indices], copy=True)
+    return torch.from_numpy(array).to(device=device, dtype=dtype)
+
+
+def source_frames_to_device(source_cache, start, end, device):
+    """Load RGB frames with the same CPU normalization order as the original code."""
+    frames = np.array(source_cache[start:end], copy=True)
+    frames = torch.from_numpy(frames).permute(0, 3, 1, 2).unsqueeze(0)
+    frames = frames.float().div_(255.0).mul_(2.0).sub_(1.0)
+    return frames.to(device=device)
+
+
+def masks_to_device(mask_cache, indices, device, dtype):
+    """Load uint8 0/255 masks in the tensor layout expected by ProPainter."""
+    masks = cache_to_device(mask_cache, indices, device, dtype)
+    return masks.unsqueeze(0).div_(255.0)
+
+
+def estimate_temporal_cache_bytes(video_length, img_h, img_w, tensor_dtype):
+    """Estimate temporary storage for source data and all timeline intermediates."""
+    tensor_size = np.dtype(tensor_dtype).itemsize
+    source_bytes = video_length * img_h * img_w * 3
+    mask_bytes = video_length * img_h * img_w * 2
+    flow_bytes = max(0, video_length - 1) * 2 * img_h * img_w * tensor_size * 4
+    propagated_bytes = video_length * img_h * img_w * tensor_size * 4
+    return source_bytes + mask_bytes + flow_bytes + propagated_bytes
+
+
+def ensure_temporal_cache_space(cache_dir, required_bytes):
+    """Fail before inference when the temporary filesystem cannot hold all stages."""
+    available_bytes = shutil.disk_usage(cache_dir).free
+    required_with_margin = int(required_bytes * 1.15)
+    if available_bytes < required_with_margin:
+        raise RuntimeError(
+            "临时时间片缓存空间不足："
+            f"需要至少 {required_with_margin / (1024 ** 3):.1f} GiB，"
+            f"当前可用 {available_bytes / (1024 ** 3):.1f} GiB。"
+        )
+
